# Web3Forms access key for the contact form.
#
# Set this in Vercel: Project > Settings > Environment Variables, for
# Production (and Preview if you want the form working on preview URLs).
# It is read server-side only by app/api/contact/route.ts and never reaches
# the browser, so do not prefix it with NEXT_PUBLIC_.
#
# While it is unset, the contact form falls back to opening the visitor's
# mail client - the behaviour the site had before.
WEB3FORMS_ACCESS_KEY=
